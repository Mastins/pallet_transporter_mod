<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="pallet_transporter_mod.transporterBeltPlaceable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="$data/shared/xml/schema/placeable.xsd">
    <storeData>
        <name>
            <cs>Automaticky Paletovy Dopravnik</cs>
            <en>Automatic Pallet transporter</en>
            <de>Automatischer Palettentransporter</de>
        </name>
        
        <image>icon_conveyor.dds</image>
        <price>4500</price>
        <lifeTime>10000</lifeTime>
        <dailyUpkeep>5</dailyUpkeep>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <brand>FOOGL</brand>
        <species>placeable</species>
        <category>storages</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>silos</tab>
        </brush>
    </storeData>

    <base>
        <filename>pallet_transporter.i3d</filename>
        <canBeRenamed>false</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End" />
        </testAreas>       
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart" widthNode="clearAreaWidth" heightNode="clearAreaHeight" />
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="0" maxSlope="90" maxEdgeAngle="90">
        <levelAreas>
            <levelArea startNode="levelAreaStart" widthNode="levelAreaWidth" heightNode="levelAreaHeight"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart" widthNode="indoorAreaWidth" heightNode="indoorAreaHeight" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart" endNode="tipOcclusionUpdateAreaEnd" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart" endNode="tipOcclusionUpdateAreaEnd" />
        </updateAreas>
    </ai>

    <colorConfigurations>
        <colorConfiguration name="s_platformou" isDefault="true" isSelectable="true" price="0">
            <objectChange node="platformNode" visibilityActive="true" visibilityInactive="false"/>
            <objectChange node="platformNode" translationActive="0 0 0" translationInactive="0 -50 0"/>
        </colorConfiguration>
        <colorConfiguration name="bez_platformy" isSelectable="true" price="-250">
            <objectChange node="platformNode" collisionActive="false" visibilityInactive="true"/>
             <objectChange node="platformNode" translationActive="0 -50 0" translationInactive="0 0 0"/>
            </colorConfiguration>
    </colorConfigurations>
<!--
    <solarPanels>
        <solarPanelsConfigurations>
           
            <solarPanelsConfiguration name="$l10n_ui_no" isActive="false" price="0">
                <objectChange node="platformNode" visibilityActive="false" visibilityInactive="true"/>
                <objectChange node="platformNode" translationActive="0 -50 0" translationInactive="0 0 0"/>
            </solarPanelsConfiguration>

            
            <solarPanelsConfiguration name="$l10n_ui_yes" isActive="true" price="500" incomePerHour="0">
                <objectChange node="platformNode" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="platformNode" translationActive="0 0 0" translationInactive="0 -50 0"/>
            </solarPanelsConfiguration>
        </solarPanelsConfigurations>
    </solarPanels>
-->

    <triggerMarkers>        
        <triggerMarker node="objectTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true" />
    </triggerMarkers>

    <hotspots>
        <hotspot type="LOADING" linkNode="objectTrigger" teleportNode="playerTriggerMarker"/>
    </hotspots>

    <palletTransporter>
        <objectTrigger node="objectTrigger" />
        <transporterStart node="transporterStart" />
        <transporterEnd node="transporterEnd" speed="1" />
    </palletTransporter>

    <i3dMappings>
        <i3dMapping id="platformNode" node="0>0|3" />
        <i3dMapping id="testArea1Start" node="1>0" />
        <i3dMapping id="testArea1End" node="1>0|0" />
        <i3dMapping id="clearAreaStart" node="2>0" />
        <i3dMapping id="clearAreaWidth" node="2>0|0" />
        <i3dMapping id="clearAreaHeight" node="2>0|1" />
        <i3dMapping id="levelAreaStart" node="3>0" />
        <i3dMapping id="levelAreaWidth" node="3>0|0" />
        <i3dMapping id="levelAreaHeight" node="3>0|1" />
        <i3dMapping id="indoorAreaStart" node="4>0" />
        <i3dMapping id="indoorAreaWidth" node="4>0|0" />
        <i3dMapping id="indoorAreaHeight" node="4>0|1" />
        <i3dMapping id="updateAreaStart" node="5>0" />
        <i3dMapping id="updateAreaWidth" node="5>0|0" />
        <i3dMapping id="updateAreaHeight" node="5>0|1" />
        <i3dMapping id="tipOcclusionUpdateAreaStart" node="6>0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd" node="6>0|0" />
        <i3dMapping id="playerTrigger" node="7>" />
        <i3dMapping id="playerTriggerMarker" node="7>0" />
        <i3dMapping id="objectTrigger" node="8>" />
        <i3dMapping id="objectTriggerMarker" node="8>0" />
        <i3dMapping id="transporterStart" node="9>" />
        <i3dMapping id="transporterEnd" node="10>" />
        

    </i3dMappings>

     
  
</placeable>
