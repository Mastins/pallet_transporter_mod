<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="objectStorage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
		<name>
				<en>Bale and Pallet Storage</en>
				<de>Ballen und Palettenlager</de>
		</name>

		<functions>
		<function>
				<en>Medium sized Shed with bale and pallet storage</en>
				<de>Mittelgroßer Unterstand mit Ballen- und Palettenlager</de>
		</function>
		</functions>

        <image>store_shedBaleStorage.dds</image>
        <price>5000</price>
        <lifetime>1000</lifetime>
        <dailyUpkeep>5</dailyUpkeep>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>placeable</species>
        <category>storages</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>silos</tab>
        </brush>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <vertexBufferMemoryUsage>164608</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>26880</indexBufferMemoryUsage>
        <textureMemoryUsage>3342336</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>shedBaleStorage.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End" />
        </testAreas>
		<sounds>
			<place template="medImp" />
		</sounds>
    </placement>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart node="0" linkNode="stopCrossing01" filename="$data/placeables/mapUS/objectStorage/stopCrossing.i3d"/>
        <dynamicallyLoadedPart node="0" linkNode="stopCrossing02" filename="$data/placeables/mapUS/objectStorage/stopCrossing.i3d"/>
        <dynamicallyLoadedPart node="0" linkNode="stopCrossing03" filename="$data/placeables/mapUS/objectStorage/stopCrossing.i3d"/>
    </dynamicallyLoadedParts>


    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height" />
    </indoorAreas>


    <triggerMarkers>
        <triggerMarker node="stopCrossing01" />
        <triggerMarker node="stopCrossing02" />
        <triggerMarker node="stopCrossing03" />
        <triggerMarker node="warningStripes" />
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconLoad.i3d"   adjustToGround="true" />
        <triggerMarker node="objectTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true" />
    </triggerMarkers>

    <hotspots>
        <hotspot type="LOADING" linkNode="objectTrigger" teleportNode="playerTriggerMarker"/>
    </hotspots>

    <infoTrigger triggerNode="infoTrigger"/>

    <objectStorage supportsBales="true" supportsPallets="true" maxLength="8.5" maxWidth="6" maxHeight="3.2">
        <playerTrigger node="playerTrigger" />
        <objectTrigger node="objectTrigger" />
        <spawnAreas>
            <spawnArea startNode="spawnArea1Start" endNode="spawnArea1End"/>
        </spawnAreas>
        <storageAreas>
            <storageArea startNode="storageArea1Start" endNode="storageArea1End"/>
        </storageAreas>
    </objectStorage>


    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
        </updateAreas>
    </ai>

	<colorConfigurations price="0" useDefaultColors="true">
		<node node="shed_vis" />
		<colorConfiguration color="0.38 0.22 0.14" name="$l10n_BrownMedium" />
        <colorConfiguration color="0.4125 0.2195 0.0742" name="$l10n_BrownMedium2"/>
		<colorConfiguration color="0.397 0.235 0.117" name="$l10n_BrownLight"/>
        <colorConfiguration color="0.0666 0.0497 0.0369" name="$l10n_BrownDark"/>
		<colorConfiguration color="0.753 0.515 0.314" name="$l10n_Beige"/>
		<colorConfiguration color="0.5 0.18 0.117" name="$l10n_BrownRed"/>
		<colorConfiguration color="0.35 0.06 0.05" name="$l10n_RedMatte"/>
        <colorConfiguration color="0.3419 0.3095 0.1274" name="$l10n_OliveBeige"/>
		<colorConfiguration color="0.25 0.39 0.25" name="$l10n_BrightGreen"/>
		<colorConfiguration color="0.098 0.184 0.08" name="$l10n_GreenMedium"/>
		<colorConfiguration color="0.05 0.18 0.2" name="$l10n_Petrol"/>
		<colorConfiguration color="0.296 0.337 0.479" name="$l10n_BrightLilac"/>
		<colorConfiguration color="0.09 0.117 0.216" name="$l10n_Lilac"/>
    </colorConfigurations>

    <animatedObjects>

        <animatedObject saveId="ColiDown" >
            <animation duration="3">
                <part node="coliLevel">
                    <keyFrame time="0.0" rotation="-60 0 0"/>
                    <keyFrame time="0.1" rotation="60 0 0"/>
                </part>
                <part node="stopCrossingColi">
                    <keyFrame time="0.0" translation="0 0 0"/>
                    <keyFrame time="1.0" translation="0 0 -4.5"/>
                </part>
            </animation>
            <controls triggerNode="coliTrigger" posAction="ACTIVATE_HANDTOOL" posText="l10nColiDown" negText="l10nColiUp" />
            <sounds>
                <moving file="$data/sounds/tools/milkrobot/milkrobot_door_01.wav" loops="0" linkNode="shed_vis" volume="0.8" radius="5" innerRadius="3" fadeOut="0.25"/>
                <posEnd file="$data/sounds/doors/doorWoodOpen_01.wav" linkNode="shed_vis" volume="0.8" radius="5" innerRadius="3" />
                <negEnd file="$data/sounds/doors/doorWoodClose_01.wav" linkNode="shed_vis" volume="0.8" radius="5" innerRadius="3" />
            </sounds>
        </animatedObject>

    </animatedObjects>


    <i3dMappings>
        <i3dMapping id="testArea1Start" node="0>0|0|0" />
        <i3dMapping id="testArea1End" node="0>0|0|0|0" />
        <i3dMapping id="clearArea1Start" node="0>0|1|0" />
        <i3dMapping id="clearArea1Width" node="0>0|1|0|0" />
        <i3dMapping id="clearArea1Height" node="0>0|1|0|1" />
        <i3dMapping id="levelArea1Start" node="0>0|2|0" />
        <i3dMapping id="levelArea1Width" node="0>0|2|0|0" />
        <i3dMapping id="levelArea1Height" node="0>0|2|0|1" />
        <i3dMapping id="indoorArea1Start" node="0>0|3|0" />
        <i3dMapping id="indoorArea1Width" node="0>0|3|0|0" />
        <i3dMapping id="indoorArea1Height" node="0>0|3|0|1" />
        <i3dMapping id="tipOcclusionUpdateArea1Start" node="0>0|4|0" />
        <i3dMapping id="tipOcclusionUpdateArea1End" node="0>0|4|0|0" />

        <i3dMapping id="coliTrigger" node="0>1|2" />
        <i3dMapping id="stopCrossingColi" node="0>1|0" />
        <i3dMapping id="stopCrossing01" node="0>1|0|1" />
        <i3dMapping id="stopCrossing02" node="0>1|0|2" />
        <i3dMapping id="stopCrossing03" node="0>1|0|3" />
        <i3dMapping id="coliLevel" node="0>1|1|0" />

        <i3dMapping id="shed_vis" node="0>2|1" />

        <i3dMapping id="spawnArea1Start" node="0>3|0|0" />
        <i3dMapping id="spawnArea1End" node="0>3|0|0|0" />
        <i3dMapping id="storageArea1Start" node="0>3|0|1" />
        <i3dMapping id="storageArea1End" node="0>3|0|1|0" />
        <i3dMapping id="objectTrigger" node="0>3|1" />
        <i3dMapping id="objectTriggerMarker" node="0>3|1|0" />
        <i3dMapping id="warningStripes" node="0>3|1|1" />
        <i3dMapping id="playerTrigger" node="0>3|2" />
        <i3dMapping id="playerTriggerMarker" node="0>3|2|0" />
        <i3dMapping id="infoTrigger" node="0>3|3" />



    </i3dMappings>
</placeable>
